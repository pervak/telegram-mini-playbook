# Telegram MCP (fast-mcp-telegram) — шаблон. Реальный .env: chmod 600, НЕ в git.
# API_ID / API_HASH — бесплатно на https://my.telegram.org → API development tools.
API_ID=
API_HASH=
DOMAIN=tg-mcp.example.com        # твой поддомен или <IP>.sslip.io

# Секрет мобильного пути nginx (/m-<SECRET>/mcp): openssl rand -hex 16
# Bearer-токен НЕ здесь — его выдаёт /setup после логина, впиши в nginx-локацию.
